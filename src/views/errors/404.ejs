<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f7fb" />
    <title>Page not found | Note Search</title>
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #172033;
        background: #f5f7fb;
      }

      * { box-sizing: border-box; }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: 24px;
        background:
          radial-gradient(ellipse at 50% 0%, #e1eaff 0, transparent 48%),
          #f5f7fb;
      }

      main {
        width: min(100%, 560px);
        padding: clamp(32px, 7vw, 64px);
        text-align: center;
        background: #fff;
        border: 1px solid #e6eaf2;
        border-radius: 24px;
        box-shadow: 0 24px 70px rgb(34 54 94 / 10%);
      }

      .code {
        margin: 0;
        color: #5269dc;
        font-size: 0.8rem;
        font-weight: 750;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      h1 {
        margin: 14px 0 12px;
        font-size: clamp(2rem, 7vw, 3rem);
        letter-spacing: -0.05em;
      }

      .message {
        margin: 0 auto 28px;
        max-width: 36ch;
        color: #657087;
        line-height: 1.65;
      }

      a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 20px;
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        background: #5269dc;
        border-radius: 12px;
        transition: background 150ms ease, transform 150ms ease;
      }

      a:hover { background: #4055c3; transform: translateY(-1px); }
      a:focus-visible { outline: 3px solid #aebaff; outline-offset: 3px; }
    </style>
  </head>
  <body>
    <main>
      <p class="code">Error 404</p>
      <h1>We can’t find that page.</h1>
      <p class="message">
        The address may be outdated, or the page may have moved. Head back to
        search and we’ll help you find what you need.
      </p>
      <a href="/ask">Back to search</a>
    </main>
  </body>
</html>
