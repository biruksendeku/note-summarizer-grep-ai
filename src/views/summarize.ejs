<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f7fb" />
    <title>Search your notes | Note Search</title>
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #172033;
        background: #f5f7fb;
      }

      * { box-sizing: border-box; }

      body {
        min-height: 100vh;
        margin: 0;
        padding: 48px 20px;
        background:
          radial-gradient(ellipse at 50% 0%, #e1eaff 0, transparent 42%),
          #f5f7fb;
      }

      main { width: min(100%, 760px); margin: 0 auto; }
      .brand { color: #5269dc; font-size: 0.85rem; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
      h1 { margin: 14px 0 10px; font-size: clamp(2rem, 6vw, 3.25rem); letter-spacing: -0.055em; }
      .intro { margin: 0; color: #657087; font-size: 1.05rem; line-height: 1.6; }

      .search-card, .results {
        margin-top: 30px;
        padding: clamp(22px, 5vw, 32px);
        background: #fff;
        border: 1px solid #e6eaf2;
        border-radius: 20px;
        box-shadow: 0 18px 50px rgb(34 54 94 / 7%);
      }

      label { display: block; margin-bottom: 10px; font-size: 0.92rem; font-weight: 700; }
      .search-row { display: flex; gap: 10px; }

      input {
        flex: 1;
        min-width: 0;
        min-height: 50px;
        padding: 0 15px;
        color: #172033;
        font: inherit;
        background: #fbfcfe;
        border: 1px solid #dce2ed;
        border-radius: 11px;
      }

      input:focus { border-color: #5269dc; outline: 3px solid #e4e9ff; }

      button {
        min-height: 50px;
        padding: 0 20px;
        color: #fff;
        font: inherit;
        font-weight: 700;
        background: #5269dc;
        border: 0;
        border-radius: 11px;
        cursor: pointer;
        transition: background 150ms ease, transform 150ms ease;
      }

      button:hover { background: #4055c3; transform: translateY(-1px); }
      button:focus-visible { outline: 3px solid #aebaff; outline-offset: 3px; }

      .alert {
        margin: 16px 0 0;
        padding: 12px 14px;
        color: #9e3434;
        background: #fff1f0;
        border: 1px solid #ffd4d0;
        border-radius: 10px;
      }

      .results { margin-top: 22px; }
      .results-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
      h2 { margin: 0; font-size: 1.25rem; }
      .count { margin: 0; color: #778198; font-size: 0.9rem; }
      .terms { display: flex; flex-wrap: wrap; gap: 7px; margin: 14px 0 0; padding: 0; list-style: none; }
      .terms li { padding: 5px 9px; color: #4055c3; font-size: 0.82rem; background: #eef1ff; border-radius: 999px; }
      .matches { display: grid; gap: 10px; margin: 20px 0 0; padding: 0; list-style: none; }
      .matches li { padding: 14px 16px; color: #384258; line-height: 1.6; background: #f8f9fc; border: 1px solid #edf0f5; border-radius: 11px; }
      .empty { margin: 18px 0 0; padding: 16px; color: #657087; line-height: 1.6; background: #f8f9fc; border-radius: 11px; }

      @media (max-width: 520px) {
        body { padding: 32px 16px; }
        .search-row { flex-direction: column; }
        button { width: 100%; }
        .results-heading { align-items: flex-start; flex-direction: column; gap: 6px; }
      }
    </style>
  </head>
  <body>
    <main>
      <p class="brand">Note Search</p>
      <h1>Find the lines that matter.</h1>
      <p class="intro">Search the corpus for a keyword and get the matching lines in seconds.</p>

      <section class="search-card" aria-label="Search">
        <form action="/ask" method="post">
          <label for="prompt">What are you looking for?</label>
          <div class="search-row">
            <input
              id="prompt"
              name="prompt"
              type="text"
              value="<%= prompt %>"
              placeholder="Try a keyword..."
              autocomplete="off"
              required
            />
            <button type="submit">Search notes</button>
          </div>
          <% if (error) { %>
            <p class="alert" role="alert"><%= error %></p>
          <% } %>
        </form>
      </section>

      <% if (Array.isArray(matches)) { %>
        <section class="results" aria-live="polite">
          <div class="results-heading">
            <h2>Search results</h2>
            <p class="count"><%= matches.length %> <%= matches.length === 1 ? "match" : "matches" %></p>
          </div>

          <% if (terms && terms.length > 0) { %>
            <ul class="terms" aria-label="Search terms">
              <% terms.forEach((term) => { %>
                <li><%= term %></li>
              <% }) %>
            </ul>
          <% } %>

          <% if (matches.length > 0) { %>
            <ul class="matches">
              <% matches.forEach((match) => { %>
                <li><%= match %></li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="empty">
              <% if (terms && terms.length === 0) { %>
                Your search only contained common words. Try a more specific keyword.
              <% } else { %>
                No lines matched that search. Try another keyword or phrase.
              <% } %>
            </p>
          <% } %>
        </section>
      <% } %>
    </main>
  </body>
</html>
